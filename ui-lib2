                        library.flags[args.flag] = k
                        kbutton.Text       = keyNames[k] or k.Name
                        kbutton.TextColor3 = Color3.fromRGB(155, 155, 155)
                    end
                end
                if not next and k == library.flags[args.flag] and args.callback then
                    args.callback()
                end
            end)

            kbutton.MouseButton1Click:Connect(function()
                if library.colorpicking then return end
                library.flags[args.flag] = Enum.KeyCode.Unknown
                kbutton.Text       = "..."
                kbutton.TextColor3 = Color3.new(0.2, 0.2, 0.2)
                next = true
            end)

            library.flags[args.flag]   = Enum.KeyCode.Unknown
            library.options[args.flag] = { type = "keybind", changeState = updateValue, skipflag = args.skipflag, oldargs = args }
            updateValue(args.key or Enum.KeyCode.Unknown)
        end

        return group, groupbox
    end

    return tab
end

local function contains(list, x)
    for _, v in pairs(list) do
        if v == x then return true end
    end
    return false
end

function library:createConfig()
    local name = library.flags["config_name"]
    if contains(library.options["selected_config"].values, name) then
        return library:notify(name .. ".cfg already exists!")
    end
    if name == "" then return library:notify("Enter a config name first.") end
    local jig = {}
    for i, v in next, library.flags do
        if library.options[i] and library.options[i].skipflag then continue end
        if typeof(v) == "Color3" then
            jig[i] = { v.R, v.G, v.B }
        elseif typeof(v) == "EnumItem" then
            jig[i] = { string.split(tostring(v), ".")[2], string.split(tostring(v), ".")[3] }
        else
            jig[i] = v
        end
    end
    if not isfolder("OsirisCFGS") then makefolder("OsirisCFGS") end
    writefile("OsirisCFGS/" .. name .. ".cfg", game:GetService("HttpService"):JSONEncode(jig))
    library:notify("Created config " .. name .. ".cfg!")
    library:refreshConfigs()
end

function library:saveConfig()
    local name = library.flags["selected_config"]
    if not name or name == "" then return library:notify("No config selected.") end
    local jig = {}
    for i, v in next, library.flags do
        if library.options[i] and library.options[i].skipflag then continue end
        if typeof(v) == "Color3" then
            jig[i] = { v.R, v.G, v.B }
        elseif typeof(v) == "EnumItem" then
            jig[i] = { string.split(tostring(v), ".")[2], string.split(tostring(v), ".")[3] }
        else
            jig[i] = v
        end
    end
    if not isfolder("OsirisCFGS") then makefolder("OsirisCFGS") end
    writefile("OsirisCFGS/" .. name .. ".cfg", game:GetService("HttpService"):JSONEncode(jig))
    library:notify("Updated config " .. name .. ".cfg!")
    library:refreshConfigs()
end

function library:loadConfig()
    local name = library.flags["selected_config"]
    if not name or name == "" then return library:notify("No config selected.") end
    if not isfile("OsirisCFGS/" .. name .. ".cfg") then
        return library:notify("Config file not found!")
    end
    local config = game:GetService("HttpService"):JSONDecode(readfile("OsirisCFGS/" .. name .. ".cfg"))
    for i, v in next, library.options do
        spawn(function()
            pcall(function()
                if config[i] then
                    if v.type == "colorpicker" then
                        v.changeState(Color3.new(config[i][1], config[i][2], config[i][3]))
                    elseif v.type == "keybind" then
                        v.changeState(Enum[config[i][1]][config[i][2]])
                    else
                        if config[i] ~= library.flags[i] then
                            v.changeState(config[i])
                        end
                    end
                else
                    if v.type == "toggle" then
                        v.changeState(false)
                    elseif v.type == "slider" then
                        v.changeState(v.oldargs and v.oldargs.value or 0)
                    elseif v.type == "textbox" or v.type == "list" or v.type == "cfg" then
                        v.changeState(v.oldargs and (v.oldargs.value or v.oldargs.text) or "")
                    elseif v.type == "colorpicker" then
                        v.changeState(v.oldargs and v.oldargs.color or Color3.new(1, 1, 1))
                    elseif v.type == "keybind" then
                        v.changeState(v.oldargs and v.oldargs.key or Enum.KeyCode.Unknown)
                    end
                end
            end)
        end)
    end
    library:notify("Loaded config " .. name .. ".cfg!")
end

function library:refreshConfigs()
    if not isfolder("OsirisCFGS") then makefolder("OsirisCFGS") end
    local tbl = {}
    for _, v in next, listfiles("OsirisCFGS") do
        local filename = v:match("([^/\\]+)$")
        if filename then table.insert(tbl, filename) end
    end
    library.options["selected_config"].refresh(tbl)
end

function library:deleteConfig()
    local name = library.flags["selected_config"]
    if name and name ~= "" and isfile("OsirisCFGS/" .. name .. ".cfg") then
        delfile("OsirisCFGS/" .. name .. ".cfg")
        library:notify("Deleted config " .. name .. ".cfg!")
        library:refreshConfigs()
    end
end

return library
