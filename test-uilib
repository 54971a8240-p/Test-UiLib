            hcorner.Parent = header

            hlabel.Parent = header
            hlabel.BackgroundTransparency = 1
            hlabel.Position = UDim2.new(0, 10, 0, 0)
            hlabel.Size = UDim2.new(1, -36, 1, 0)
            hlabel.Font = Enum.Font.Gotham
            hlabel.Text = ddText
            hlabel.TextColor3 = Color3.fromRGB(160, 160, 175)
            hlabel.TextSize = 13
            hlabel.TextXAlignment = Enum.TextXAlignment.Left

            arrow.Parent = header
            arrow.BackgroundTransparency = 1
            arrow.AnchorPoint = Vector2.new(1, 0.5)
            arrow.Position = UDim2.new(1, -8, 0.5, 0)
            arrow.Size = UDim2.new(0, 16, 0, 16)
            arrow.Image = "rbxassetid://3926305904"
            arrow.ImageRectOffset = Vector2.new(564, 284)
            arrow.ImageRectSize = Vector2.new(36, 36)
            arrow.ImageColor3 = Color3.fromRGB(160, 160, 175)
            arrow.Rotation = 90

            ddcontainer.Name = "dropdowncontainer"
            ddcontainer.Parent = wrapper
            ddcontainer.Active = true
            ddcontainer.BackgroundColor3 = BG_LIGHT
            ddcontainer.BorderSizePixel = 0
            ddcontainer.Position = UDim2.new(0, 0, 1, 4)
            ddcontainer.Size = UDim2.new(1, 0, 0, 0)
            ddcontainer.BottomImage = "rbxasset://textures/ui/Scroll/scroll-middle.png"
            ddcontainer.TopImage = "rbxasset://textures/ui/Scroll/scroll-middle.png"
            ddcontainer.CanvasSize = UDim2.new(0, 0, 0, 0)
            ddcontainer.ScrollBarThickness = 2
            ddcontainer.ScrollBarImageColor3 = ACCENT
            ddcontainer.Visible = false
            ddcontainer.ZIndex = 10
            ddcontainer.ClipsDescendants = true
            local dccorner = Instance.new("UICorner")
            dccorner.CornerRadius = UDim.new(0, 4)
            dccorner.Parent = ddcontainer

            ddlist.Parent = ddcontainer
            ddlist.SortOrder = Enum.SortOrder.LayoutOrder
            ddlist:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
                ddcontainer.CanvasSize = UDim2.new(0, 0, 0, ddlist.AbsoluteContentSize.Y)
            end)

            local optionButtons = {}

            local function updateLabel()
                local keys = {}
                for k in pairs(selected) do table.insert(keys, k) end
                table.sort(keys)
                if #keys == 0 then
                    hlabel.Text = ddText
                    hlabel.TextColor3 = Color3.fromRGB(160, 160, 175)
                elseif #keys == 1 then
                    hlabel.Text = keys[1]
                    hlabel.TextColor3 = TEXT
                elseif #keys <= 3 then
                    hlabel.Text = table.concat(keys, ", ")
                    hlabel.TextColor3 = TEXT
                else
                    hlabel.Text = #keys .. " selected"
                    hlabel.TextColor3 = ACCENT
                end
            end

            local function setOpen(state)
                open = state
                if open then
                    ddcontainer.Visible = true
                    TweenService:Create(arrow, TweenInfo.new(0.2), {Rotation = 270}):Play()
                    TweenService:Create(header, TweenInfo.new(0.2), {BackgroundColor3 = BG_HOVER}):Play()
                    local targetH = math.min(#list * 30, 120)
                    ddcontainer:TweenSize(UDim2.new(1, 0, 0, targetH), "In", "Quad", 0.2)
                    container.CanvasSize = UDim2.new(0, 0, 0, containerlist.AbsoluteContentSize.Y + targetH + 16)
                else
                    TweenService:Create(arrow, TweenInfo.new(0.2), {Rotation = 90}):Play()
                    TweenService:Create(header, TweenInfo.new(0.2), {BackgroundColor3 = BG_LIGHT}):Play()
                    ddcontainer:TweenSize(UDim2.new(1, 0, 0, 0), "Out", "Quad", 0.2)
                    task.delay(0.2, function()
                        if not open then
                            ddcontainer.Visible = false
                            container.CanvasSize = UDim2.new(0, 0, 0, containerlist.AbsoluteContentSize.Y + 12)
                        end
                    end)
                end
            end

            header.MouseEnter:Connect(function()
                if not open then TweenService:Create(header, TweenInfo.new(0.2), {BackgroundColor3 = BG_HOVER}):Play() end
            end)
            header.MouseLeave:Connect(function()
                if not open then TweenService:Create(header, TweenInfo.new(0.2), {BackgroundColor3 = BG_LIGHT}):Play() end
            end)
            header.MouseButton1Click:Connect(function()
                setOpen(not open)
            end)

            for _, v in ipairs(list) do
                local row = Instance.new("TextButton")
                local rcorner = Instance.new("UICorner")
                local check = Instance.new("Frame")
                local checkcorner = Instance.new("UICorner")
                local checkmark = Instance.new("TextLabel")
                local optlabel = Instance.new("TextLabel")

                row.Parent = ddcontainer
                row.BackgroundColor3 = BG_LIGHT
                row.BorderSizePixel = 0
                row.AutoButtonColor = false
                row.Text = ""
                row.Size = UDim2.new(1, 0, 0, 30)
                row.ZIndex = 11
                rcorner.CornerRadius = UDim.new(0, 3)
                rcorner.Parent = row

                check.Parent = row
                check.AnchorPoint = Vector2.new(0, 0.5)
                check.Position = UDim2.new(0, 8, 0.5, 0)
                check.Size = UDim2.new(0, 16, 0, 16)
                check.BackgroundColor3 = Color3.fromRGB(55, 55, 68)
                check.BorderSizePixel = 0
                check.ZIndex = 12
                checkcorner.CornerRadius = UDim.new(0, 3)
                checkcorner.Parent = check

                checkmark.Parent = check
                checkmark.BackgroundTransparency = 1
                checkmark.Size = UDim2.new(1, 0, 1, 0)
                checkmark.Font = Enum.Font.GothamBold
                checkmark.Text = "✓"
                checkmark.TextColor3 = ACCENT
                checkmark.TextSize = 12
                checkmark.Visible = false
                checkmark.ZIndex = 13

                optlabel.Parent = row
                optlabel.BackgroundTransparency = 1
                optlabel.Position = UDim2.new(0, 32, 0, 0)
                optlabel.Size = UDim2.new(1, -40, 1, 0)
                optlabel.Font = Enum.Font.Gotham
                optlabel.Text = v
                optlabel.TextColor3 = TEXT
                optlabel.TextSize = 13
                optlabel.TextXAlignment = Enum.TextXAlignment.Left
                optlabel.ZIndex = 12

                optionButtons[v] = {row = row, check = check, checkmark = checkmark}

                local function refreshVisual()
                    if selected[v] then
                        TweenService:Create(check, TweenInfo.new(0.15), {BackgroundColor3 = ACCENT}):Play()
                        checkmark.Visible = true
                        TweenService:Create(optlabel, TweenInfo.new(0.15), {TextColor3 = ACCENT}):Play()
                    else
                        TweenService:Create(check, TweenInfo.new(0.15), {BackgroundColor3 = Color3.fromRGB(55, 55, 68)}):Play()
                        checkmark.Visible = false
                        TweenService:Create(optlabel, TweenInfo.new(0.15), {TextColor3 = TEXT}):Play()
                    end
                end

                row.MouseEnter:Connect(function()
                    TweenService:Create(row, TweenInfo.new(0.15), {BackgroundColor3 = BG_HOVER}):Play()
                end)
                row.MouseLeave:Connect(function()
                    TweenService:Create(row, TweenInfo.new(0.15), {BackgroundColor3 = BG_LIGHT}):Play()
                end)
                row.MouseButton1Click:Connect(function()
                    if selected[v] then
                        selected[v] = nil
                    else
                        selected[v] = true
                    end
                    refreshVisual()
                    updateLabel()
                    -- Return list of selected keys
                    local keys = {}
                    for k in pairs(selected) do table.insert(keys, k) end
                    pcall(callback, keys)
                end)
            end
        end

        -- ---- Textbox ----
        function tab:Textbox(tbText, disappear, callback)
            callback = callback or function() end
            local textbox = Instance.new("Frame")
            local tcorner = Instance.new("UICorner")
            local tlabel = Instance.new("TextLabel")
            local tbframe = Instance.new("Frame")
            local tbcorner = Instance.new("UICorner")
            local tbmain = Instance.new("TextBox")

            textbox.Parent = container
            textbox.BackgroundColor3 = BG_LIGHT
            textbox.BorderSizePixel = 0
            textbox.Size = UDim2.new(1, 0, 0, 30)
            tcorner.CornerRadius = UDim.new(0, 4)
            tcorner.Parent = textbox

            tlabel.Parent = textbox
            tlabel.BackgroundTransparency = 1
            tlabel.Position = UDim2.new(0, 10, 0, 0)
            tlabel.Size = UDim2.new(0.45, 0, 1, 0)
            tlabel.Font = Enum.Font.Gotham
            tlabel.Text = tbText
            tlabel.TextColor3 = TEXT
            tlabel.TextSize = 13
            tlabel.TextXAlignment = Enum.TextXAlignment.Left

            tbframe.Parent = textbox
            tbframe.AnchorPoint = Vector2.new(1, 0.5)
            tbframe.Position = UDim2.new(1, -8, 0.5, 0)
            tbframe.Size = UDim2.new(0.5, -16, 0, 22)
            tbframe.BackgroundColor3 = BG_DARK
            tbframe.BorderSizePixel = 0
            tbcorner.CornerRadius = UDim.new(0, 4)
            tbcorner.Parent = tbframe

            tbmain.Parent = tbframe
            tbmain.BackgroundTransparency = 1
            tbmain.BorderSizePixel = 0
            tbmain.Size = UDim2.new(1, -8, 1, 0)
            tbmain.Position = UDim2.new(0, 4, 0, 0)
            tbmain.Font = Enum.Font.Gotham
            tbmain.PlaceholderText = "..."
            tbmain.PlaceholderColor3 = Color3.fromRGB(100, 100, 115)
            tbmain.Text = ""
            tbmain.TextColor3 = TEXT
            tbmain.TextSize = 13
            tbmain.ClearTextOnFocus = false

            tbmain.FocusLost:Connect(function(ep)
                if ep and #tbmain.Text > 0 then
                    pcall(callback, tbmain.Text)
                    if disappear then tbmain.Text = "" end
                end
            end)
        end

        return tab
    end
    return tabs
end

return lib
